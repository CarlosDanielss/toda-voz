---
import { getEntry } from 'astro:content';
import DocPage from '../../components/DocPage.astro';
import { Obstaculos } from '@/components/Obstaculos';
import { conferirDecisoesCitadas, rotasDasDecisoes } from '../../lib/projeto';

const doc = await getEntry('contexto', 'obstaculos-e-solucoes');
if (!doc) throw new Error('context/obstaculos-e-solucoes.md não encontrado.');
const itens = doc.data.itens ?? [];
const rotas = await rotasDasDecisoes();
conferirDecisoesCitadas(itens, rotas);
---

<DocPage entry={doc} kind="Contexto">
  <div class="max-w-5xl">
    <Obstaculos itens={itens} rotas={rotas} agrupar />
  </div>
</DocPage>
